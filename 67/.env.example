# Avenue Assets Discord Bot example environment variables
# Copy this file to .env and fill in your values.

# Core bot settings
DISCORD_TOKEN=
SERVER_ID=
BOT_PREFIX=!

# Optional role IDs for access control
MODERATOR_ROLE_ID=
MARKETING_ROLE_ID=
CEO_ROLE_ID=
COO_ROLE_ID=
TEAM_LEADER_ROLE_ID=
SUPPORT_ROLE_ID=
MANAGEMENT_ROLE_ID=
PRODUCT_MANAGER_ROLE_ID=

# Ticket and partner workflow configuration
SUPPORT_CATEGORY_ID=
MARKETING_CATEGORY_ID=
MANAGEMENT_CATEGORY_ID=
PARTNERS_CHANNEL_ID=
PARTNER_LOGS_CHANNEL_ID=
MARKETING_ANNOUNCEMENTS_CHANNEL_ID=
MARKETING_LOGS_CHANNEL_ID=
MAIN_ANNOUNCEMENTS_CHANNEL_ID=
LOGS_CHANNEL_ID=
TICKET_LOGS_CHANNEL_ID=
WELCOME_CHANNEL_ID=
GOODBYE_CHANNEL_ID=
PRODUCTS_FORUM_CHANNEL_ID=

# Database configuration
DATABASE_URL=sqlite:///bot_database.db
# Or use DATABASE_PATH=/path/to/bot_database.db
# DATABASE_PATH=/var/data/bot_database.db

# Webserver / Stripe configuration
BASE_URL=http://localhost:10000
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:10000/stripe/success
STRIPE_CANCEL_URL=http://localhost:10000/stripe/cancel

# Optional features
OPENAI_API_KEY=
GIVEAWAY_EMOJI=🎉
